@host = http://localhost:8000

### ===== Auth =====

### Login
POST {{host}}/login
Content-Type: application/json

{
  "telephone": "18012345678",
  "password": "123456"
}

### Register
POST {{host}}/register
Content-Type: application/json

{
  "telephone": "18012345678",
  "password": "123456",
  "nickname": "testuser"
}

### ===== User =====

### Update user info
POST {{host}}/user/update-user-info
Content-Type: application/json

{
  "uuid": "U12345678901",
  "nickname": "Jane Doe",
  "email": "test@example.com",
  "birthday": "19990101",
  "signature": "hello world",
  "avatar": ""
}

### Get user info
POST {{host}}/user/get-user-info
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### Get user info list (admin)
POST {{host}}/user/get-user-info-list
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### Enable users
POST {{host}}/user/able-users
Content-Type: application/json

{
  "uuid_list": ["U12345678901"]
}

### Disable users
POST {{host}}/user/disable-users
Content-Type: application/json

{
  "uuid_list": ["U12345678901"]
}

### Delete users
POST {{host}}/user/delete-users
Content-Type: application/json

{
  "uuid_list": ["U12345678901"]
}

### Set admin
POST {{host}}/user/set-admin
Content-Type: application/json

{
  "uuid_list": ["U12345678901"],
  "is_admin": 1
}

### WebSocket logout
POST {{host}}/user/ws-logout
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### ===== Group =====

### Create group
# add_mode: 0 = direct join, 1 = owner approval
POST {{host}}/group/create-group
Content-Type: application/json

{
  "name": "test group",
  "owner_id": "U12345678901",
  "avatar": "",
  "notice": "group announcement",
  "add_mode": 0
}

### Load my groups
POST {{host}}/group/load-my-group
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### Check group add mode
POST {{host}}/group/check-group-add-mode
Content-Type: application/json

{
  "group_id": "G12345678901"
}

### Enter group directly
POST {{host}}/group/enter-group-directly
Content-Type: application/json

{
  "user_id": "U12345678901",
  "group_id": "G12345678901"
}

### Leave group
POST {{host}}/group/leave-group
Content-Type: application/json

{
  "user_id": "U12345678901",
  "group_id": "G12345678901"
}

### Dismiss group
POST {{host}}/group/dismiss-group
Content-Type: application/json

{
  "group_id": "G12345678901"
}

### Get group info
POST {{host}}/group/get-group-info
Content-Type: application/json

{
  "group_id": "G12345678901"
}

### Update group info
# add_mode is optional; omit it to keep the current mode
POST {{host}}/group/update-group-info
Content-Type: application/json

{
  "uuid": "G12345678901",
  "name": "new name",
  "notice": "group announcement",
  "avatar": "",
  "add_mode": 1
}

### Get group member list
POST {{host}}/group/get-group-member-list
Content-Type: application/json

{
  "group_id": "G12345678901"
}

### Remove group members
POST {{host}}/group/remove-group-members
Content-Type: application/json

{
  "group_id": "G12345678901",
  "member_ids": ["U12345678902"]
}

### Get group info list (admin)
POST {{host}}/group/get-group-info-list
Content-Type: application/json

{}

### Delete groups (admin)
POST {{host}}/group/delete-groups
Content-Type: application/json

{
  "uuid_list": ["G12345678901"]
}

### Set groups status (admin)
POST {{host}}/group/set-groups-status
Content-Type: application/json

{
  "uuid_list": ["G12345678901"],
  "status": 1
}

### ===== Session =====

### Open session
POST {{host}}/session/open-session
Content-Type: application/json

{
  "send_id": "U12345678901",
  "receive_id": "U12345678902"
}

### Get user session list
POST {{host}}/session/get-user-session-list
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### Get group session list
POST {{host}}/session/get-group-session-list
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### Delete session
POST {{host}}/session/delete-session
Content-Type: application/json

{
  "owner_id": "U12345678901",
  "session_id": "S12345678901"
}

### Check open session allowed
POST {{host}}/session/check-open-session-allowed
Content-Type: application/json

{
  "send_id": "U12345678901",
  "receive_id": "U12345678902"
}

### ===== Contact =====

### Get contact list
POST {{host}}/contact/get-user-list
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### Load my joined groups
POST {{host}}/contact/load-my-joined-group
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### Get contact info
POST {{host}}/contact/get-contact-info
Content-Type: application/json

{
  "user_id": "U12345678901",
  "contact_id": "U12345678902"
}

### Apply contact
POST {{host}}/contact/apply-contact
Content-Type: application/json

{
  "user_id": "U12345678901",
  "contact_id": "U12345678902",
  "contact_type": 0,
  "message": "hi, I am xxx"
}

### Get new contact applications
POST {{host}}/contact/get-new-contact-list
Content-Type: application/json

{
  "user_id": "U12345678901"
}

### Approve contact application
POST {{host}}/contact/pass-contact-apply
Content-Type: application/json

{
  "apply_id": "A12345678901"
}

### Refuse contact application
POST {{host}}/contact/refuse-contact-apply
Content-Type: application/json

{
  "apply_id": "A12345678901"
}

### Block application
POST {{host}}/contact/black-apply
Content-Type: application/json

{
  "apply_id": "A12345678901"
}

### Get add group list
# Returns pending join applications for every group the caller owns
POST {{host}}/contact/get-add-group-list
Content-Type: application/json

{
  "user_id": "U12345678901"
}

### Block contact
POST {{host}}/contact/black-contact
Content-Type: application/json

{
  "user_id": "U12345678901",
  "contact_id": "U12345678902"
}

### Unblock contact
POST {{host}}/contact/cancel-black-contact
Content-Type: application/json

{
  "user_id": "U12345678901",
  "contact_id": "U12345678902"
}

### Delete contact
POST {{host}}/contact/delete-contact
Content-Type: application/json

{
  "user_id": "U12345678901",
  "contact_id": "U12345678902"
}

### ===== Message =====

### Get direct message list
POST {{host}}/message/get-message-list
Content-Type: application/json

{
  "send_id": "U12345678901",
  "receive_id": "U12345678902"
}

### Get group message list
POST {{host}}/message/get-group-message-list
Content-Type: application/json

{
  "group_id": "G12345678901"
}

### Upload avatar (multipart/form-data)
POST {{host}}/message/upload-avatar
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./test-avatar.png
--boundary--

### Upload file (multipart/form-data)
POST {{host}}/message/upload-file
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="doc.pdf"
Content-Type: application/pdf

< ./test-doc.pdf
--boundary--

### ===== Chatroom =====

### Get online users
POST {{host}}/chatroom/get-online-users
Content-Type: application/json

{}

### ===== WebSocket =====

### WebSocket connection (use a ws client)
# GET {{host}}/wss?client_id=U12345678901
# Upgrade: websocket
# Connection: Upgrade

### Cache dashboard WebSocket (internal, swifty_cache monitoring)
# GET {{host}}/dashboard/ws
# Upgrade: websocket
# Connection: Upgrade

### ===== Migrated capabilities (auth, tags, search, unread, calls, chunked upload) =====
### Most POST endpoints now require: Authorization: {{token}} (from login/register response data.token)

### Update password (public, forgot-password flow)
POST {{host}}/user/update-password
Content-Type: application/json

{
  "telephone": "18012345678",
  "password": "654321"
}

### Search users by telephone/nickname keyword
POST {{host}}/user/search-user
Content-Type: application/json

{
  "owner_id": "U12345678901",
  "keyword": "jane"
}

### Search groups by name keyword
POST {{host}}/group/search-group
Content-Type: application/json

{
  "owner_id": "U12345678901",
  "keyword": "chat"
}

### Invite members into a group (skips existing members)
POST {{host}}/group/invite-group-members
Content-Type: application/json

{
  "group_id": "G12345678901",
  "member_ids": ["U12345678902", "U12345678903"]
}

### Get contact tag list
POST {{host}}/contact/get-tag-list
Content-Type: application/json

{
  "owner_id": "U12345678901"
}

### Add a contact tag
POST {{host}}/contact/add-tag
Content-Type: application/json

{
  "owner_id": "U12345678901",
  "name": "Colleagues"
}

### Update a contact's note name / tag
POST {{host}}/contact/update-contact
Content-Type: application/json

{
  "user_id": "U12345678901",
  "contact_id": "U12345678902",
  "note_name": "Bestie",
  "tag_id": "T12345678901"
}

### Mark a session as read (clears unread count)
POST {{host}}/session/mark-session-read
Content-Type: application/json

{
  "owner_id": "U12345678901",
  "receive_id": "U12345678902"
}

### Verify file before chunked upload (instant upload / resume)
POST {{host}}/file/verify
Content-Type: application/json

{
  "file_hash": "d41d8cd98f00b204e9800998ecf8427e",
  "chunk_cnt": 3,
  "ext_name": "mp4"
}

### Upload one chunk (multipart form: chunk, chunk_idx, file_hash, ext_name)
# POST {{host}}/file/upload-chunk

### Merge uploaded chunks
POST {{host}}/file/merge
Content-Type: application/json

{
  "file_hash": "d41d8cd98f00b204e9800998ecf8427e",
  "ext_name": "mp4",
  "file_name": "demo.mp4"
}

### List members of an active call room
POST {{host}}/chatroom/get-callers
Content-Type: application/json

{
  "room_id": "G12345678901",
  "owner_id": "U12345678901"
}
